<table class="table table-condensed table-bordered">
	<tbody>
		<tr>
			{{#each groups as |group|}}
			<td class="text-center" style="vertical-align:top; padding:0">
				<table class="table table-condensed table-bordered" style="margin:0">
					<tbody>
						<tr>
							<th class="text-center">{{group.formats}}</th>
						</tr>
						{{#each group.items as |format|}}
						<tr>
							<th class="text-center bg-{{@root.card.faction_code}}">{{format.displayName}}</th>
						</tr>
						<tr>
							<td
								class="text-center fg-{{@root.card.faction_code}} {{#unless (legal @root.card.code format.code)}}no-{{/unless}}legal">
								{{#if (errata @root.card.code format.code)}}
								<span class="fa fa-lg fa-exclamation-triangle" data-toggle="tooltip"
									title="{{trans 'card.format.errata'}}"></span>
								{{else if (ban @root.card.code format.code)}}
								<span class="fa fa-lg fa-times-circle" data-toggle="tooltip"
									title="{{trans 'card.format.banned'}}"></span>
								{{else}}
								<span
									class="fa fa-lg {{ternary (legal @root.card.code format.code) 'fa-check-circle' 'fa-ban'}}"></span>
								{{/if}}
							</td>
						</tr>
						{{/each}}
					</tbody>
				</table>
			</td>
			{{/each}}
		</tr>
	</tbody>
</table>