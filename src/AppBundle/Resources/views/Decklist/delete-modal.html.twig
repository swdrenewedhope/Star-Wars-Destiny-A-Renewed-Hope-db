<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
				<h3 class="modal-title" id="deleteModalLabel" style="text-align: center;">Are you sure?</h3>
			</div>
			<div class="modal-body">
				<div class="row">
					<p style="text-align: center;">You are about to delete your published deck: '{{ decklist.name }}'</p>
					<div class="col-md-12">
						<form action="{{ path('decklist_delete', {decklist_id:decklist.id}) }}" method="POST" enctype="application/x-www-form-urlencoded" id="delete-decklistform">
							<input type="hidden" name="decklist_id" id="delete-decklist-id" value="{{ decklist.id }}">
							<div style="text-align: center;">
								<button type="submit" id="btn-delete-submit" class="btn btn-danger">Delete, i must.</button>
								<button type="button" class="btn btn-info" onclick="$('#deleteModal').modal('hide')">Nooooooooooo!</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
