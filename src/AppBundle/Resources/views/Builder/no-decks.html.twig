{% extends 'AppBundle::layout.html.twig' %}

{% block body %}

<div class="jumbotron" style="text-align:center" id="no-deck-available">
  <div class="main white container">
    <h1 style="font-size: 5rem;">{{'decks.no-decks.heading' | trans}}</h1>
	<p>{% trans %}decks.no-decks.paragraph{% endtrans %}</p>
	<a href="{{ path('deck_buildform') }}" class="btn btn-default btn-lg"><span class="fa fa-plus"></span> {{ 'decks.form.build' | trans }}</a>
	<button type="button" class="btn btn-default btn-lg" onclick="$('#fileModal').modal('show')"><span class="fa fa-upload"></span> {{ 'forms.upload' | trans}}</button>
  </div>
</div>

{% include 'AppBundle:Modale:file.html.twig' %}

{% endblock %}
