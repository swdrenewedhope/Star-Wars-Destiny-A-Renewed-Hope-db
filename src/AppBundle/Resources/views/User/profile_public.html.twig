{% extends 'AppBundle::layout.html.twig' %}
{% block body %}
<div class="main white container">
<div class="jumbotron background-{{ user.color }}-10">
   <h1>
  {% if user.donation > 0 %}<span class="icon-set-TPG donator" style="font-size: 42px" title="Donator"></span>{% endif %}
  <span class="fg-{{ user.color }}">{{ user.username }}</span>
  {% if user.donation > 0 %}<span class="icon-set-TPG donator flipped" style="font-size: 42px" title="Donator"></span>{% endif %}
   </h1>
	<p>
        {{'profile.public.since' | trans({'%date%': user.dateCreation|localizeddate('long', 'none') })}}.
        <div>
        {% if user.decklists|length > 0 %}
            <a href="{{ path('decklists_list',{type:'find',page:1,author:user.username}) }}">
                {{'profile.public.published_decklists' | transchoice(user.decklists|length, {'%count%': user.decklists|length})}}.
            </a>
        {% else %}
            {{'profile.public.published_decklists' | transchoice(user.decklists|length, {'%count%': user.decklists|length})}}.
        {% endif %}
        </div>
	</p>
    {% if user.resume %} <p><em>{{ user.resume }}</em></p> {% endif %}
	</div>
</div>
{% endblock %}
